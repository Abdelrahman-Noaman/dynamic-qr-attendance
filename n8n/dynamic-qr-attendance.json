    {
      "parameters": {
        "jsCode": "const KEY = 'MySecretyKey2005';\nconst q = $input.first().json.query || {};\nif (q.key !== KEY) return [{ json: { ok: false, error: 'unauthorized' } }];\n\nconst wf = $getWorkflowStaticData('global');\nconst s = wf.session;\nif (!s || !s.active) return [{ json: { ok: true, active: false } }];\n\nconst TTL = 10000;\nconst rand = (n) => { const c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s = ''; for (let i = 0; i < n; i++) s += c[Math.floor(Math.random() * c.length)]; return s; };\nconst now = Date.now();\nif (now - s.issuedAt >= TTL) {\n  s.token = rand(6); // old token is overwritten = invalid\n  s.issuedAt += TTL * Math.floor((now - s.issuedAt) / TTL); // keep a clean 10s grid\n}\nreturn [{ json: {\n  ok: true, active: true,\n  sessionId: s.sessionId, lecture: s.lecture,\n  token: s.token,\n  expiresInMs: TTL - (Date.now() - s.issuedAt)\n} }];"
      },
