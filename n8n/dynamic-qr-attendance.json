    {
      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst s = String(q.s || '');\nconst t = String(q.t || '').toUpperCase();\nconst ses = $getWorkflowStaticData('global').session;\nconst now = Date.now();\nlet reason = '';\nif (!ses || !ses.active) reason = 'SESSION_CLOSED';\nelse if (ses.sessionId !== s) reason = 'WRONG_SESSION';\nelse if (now - ses.issuedAt >= 10000) reason = 'TOKEN_EXPIRED';\nelse if (ses.token !== t) reason = 'TOKEN_INVALID';\n\nconst exp = now + 3 * 60 * 1000; // ticket lifetime: 3 minutes\nreturn [{ json: {\n  valid: reason === '', reason,\n  lecture: ses ? ses.lecture : '',\n  payload: `${s}.${t}.${exp}`\n} }];"
      },
