        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Attendance Confirmed</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#172033;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f4f7fb; padding:40px 15px;\">\n    <tr>\n      <td align=\"center\">\n\n        <!-- Main Container -->\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n          style=\"max-width:600px; width:100%; background:#ffffff; border-radius:18px; overflow:hidden; box-shadow:0 8px 30px rgba(15,23,42,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background:#0f172a; padding:32px 40px; text-align:center;\">\n\n              <div style=\"font-size:14px; font-weight:bold; letter-spacing:2px; color:#94a3b8; text-transform:uppercase;\">\n                Data Security\n              </div>\n\n              <div style=\"font-size:28px; font-weight:700; color:#ffffff; margin-top:10px;\">\n                Attendance Confirmed\n              </div>\n\n              <div style=\"font-size:14px; color:#cbd5e1; margin-top:8px;\">\n                Your attendance has been successfully recorded.\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Success Icon -->\n          <tr>\n            <td align=\"center\" style=\"padding:32px 40px 10px 40px;\">\n\n              <div style=\"\n                width:64px;\n                height:64px;\n                line-height:64px;\n                background:#ecfdf5;\n                border-radius:50%;\n                color:#16a34a;\n                font-size:32px;\n                font-weight:bold;\n                margin:auto;\n              \">\n                ✓\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Message -->\n          <tr>\n            <td style=\"padding:20px 45px 10px 45px; text-align:center;\">\n\n              <div style=\"font-size:16px; line-height:1.7; color:#475569;\">\n                Your attendance for today's\n                <strong style=\"color:#0f172a;\">\n                  {{ $('Validate Submission').first().json.lecture }}\n                </strong>\n                lecture has been successfully recorded.\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Attendance Details -->\n          <tr>\n            <td style=\"padding:25px 45px;\">\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                style=\"background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;\">\n\n                <tr>\n                  <td style=\"padding:18px 20px; border-bottom:1px solid #e2e8f0;\">\n                    <span style=\"font-size:12px; color:#64748b; text-transform:uppercase; letter-spacing:0.8px;\">\n                      Status\n                    </span>\n                    <br>\n                    <span style=\"font-size:16px; font-weight:700; color:#16a34a;\">\n                      ● Present\n                    </span>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:18px 20px; border-bottom:1px solid #e2e8f0;\">\n                    <span style=\"font-size:12px; color:#64748b; text-transform:uppercase; letter-spacing:0.8px;\">\n                      Lecture\n                    </span>\n                    <br>\n                    <span style=\"font-size:16px; font-weight:600; color:#0f172a;\">\n                      {{ $('Validate Submission').first().json.lecture }}\n                    </span>\n                  </td>\n                </tr>\n\n                <tr>\n                  <td style=\"padding:18px 20px;\">\n                    <span style=\"font-size:12px; color:#64748b; text-transform:uppercase; letter-spacing:0.8px;\">\n                      Recorded At\n                    </span>\n                    <br>\n                    <span style=\"font-size:16px; font-weight:600; color:#0f172a;\">\n                      {{ $now.toFormat('yyyy-MM-dd · HH:mm') }}\n                    </span>\n                  </td>\n                </tr>\n\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Confirmation Message -->\n          <tr>\n            <td style=\"padding:5px 45px 30px 45px; text-align:center;\">\n\n              <div style=\"font-size:14px; line-height:1.6; color:#64748b;\">\n                You don't need to take any further action.\n                This email confirms that your attendance has been registered successfully.\n              </div>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"background:#f8fafc; border-top:1px solid #e2e8f0; padding:24px 40px; text-align:center;\">\n\n              <div style=\"font-size:13px; font-weight:600; color:#334155;\">\n                {{ $('Validate Submission').first().json.lecture }} Attendance System\n              </div>\n\n              <div style=\"font-size:12px; color:#94a3b8; margin-top:7px;\">\n                Automated attendance confirmation\n              </div>\n\n              <div style=\"font-size:11px; color:#cbd5e1; margin-top:14px;\">\n                Please do not reply to this automated email.\n              </div>\n\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
