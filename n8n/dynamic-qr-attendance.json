    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst [sessionId, token, exp, sig] = String(b.ticket || '').split('.');\nreturn [{ json: {\n  sessionId, token, exp: Number(exp), sig,\n  payload: `${sessionId}.${token}.${exp}`,\n  name: String(b.name || '').trim(),\n  studentId: String(b.studentId || '').trim(),\n  email: String(b.email || '').trim().toLowerCase(),\n  deviceId: String(b.deviceId || '').trim()\n} }];"
      },
      "id": "94a5ad5e-f6af-4cb6-bc22-8e140a11069d",
      "name": "Parse Submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        1056
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.payload }}",
        "dataPropertyName": "expectedSig",
        "secret": "REPLACE_WITH_SIGN_SECRET"
      },
      "id": "6e5536f7-17ae-45e7-a04c-6898b9af99ba",
      "name": "Verify Ticket Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        528,
        1056
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst s = $getWorkflowStaticData('global').session;\nlet reason = '';\nif (j.sig !== j.expectedSig) reason = 'BAD_TICKET';\nelse if (Date.now() > j.exp) reason = 'TICKET_EXPIRED';\nelse if (!s || !s.active || s.sessionId !== j.sessionId) reason = 'SESSION_CLOSED';\nelse if (!j.name || !j.studentId || !j.email) reason = 'MISSING_FIELDS';\nelse if (!j.deviceId) reason = 'DEVICE_ID_REQUIRED';\nelse if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(j.email)) reason = 'BAD_EMAIL';\n// optional: else if (!j.email.endsWith('@your-university.edu')) reason = 'BAD_EMAIL';\nreturn [{ json: { ...j, valid: reason === '', reason, lecture: s ? s.lecture : '' } }];"
      },
