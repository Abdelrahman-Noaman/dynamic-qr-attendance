        "jsCode": "const KEY = 'MySecretyKey2005';\nif (($input.first().json.body || {}).key !== KEY) return [{ json: { ok: false } }];\nconst wf = $getWorkflowStaticData('global');\nif (wf.session) { wf.session.active = false; wf.session.token = null; }\nreturn [{ json: { ok: true } }];"
