    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst [sessionId, token, exp, sig] = String(b.ticket || '').split('.');\nreturn [{ json: {\n  sessionId, token, exp: Number(exp), sig,\n  payload: `${sessionId}.${token}.${exp}`,\n  name: String(b.name || '').trim(),\n  studentId: String(b.studentId || '').trim(),\n  email: String(b.email || '').trim().toLowerCase()\n} }];"
      },
      "id": "042ca026-fbd3-4094-b02f-eed266f0f1d7",
      "name": "Parse Submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        1120
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.payload }}",
        "dataPropertyName": "expectedSig",
        "secret": "REPLACE_WITH_SIGN_SECRET"
      },
      "id": "3d570d6b-a1db-41a6-ad5e-51d499642cb3",
      "name": "Verify Ticket Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        1088,
        1120
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst s = $getWorkflowStaticData('global').session;\nlet reason = '';\nif (j.sig !== j.expectedSig) reason = 'BAD_TICKET';\nelse if (Date.now() > j.exp) reason = 'TICKET_EXPIRED';\nelse if (!s || !s.active || s.sessionId !== j.sessionId) reason = 'SESSION_CLOSED';\nelse if (!j.name || !j.studentId) reason = 'MISSING_FIELDS';\nelse if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(j.email)) reason = 'BAD_EMAIL';\n// optional: else if (!j.email.endsWith('@your-university.edu')) reason = 'BAD_EMAIL';\nreturn [{ json: { ...j, valid: reason === '', reason, lecture: s ? s.lecture : '' } }];"
      },
