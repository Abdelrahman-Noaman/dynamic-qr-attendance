    {
      "parameters": {
        "jsCode": "const KEY = 'REPLACE_WITH_PROF_KEY';\nif (($input.first().json.body || {}).key !== KEY) return [{ json: { ok: false } }];\nconst wf = $getWorkflowStaticData('global');\nif (wf.session) { wf.session.active = false; wf.session.token = null; }\nreturn [{ json: { ok: true } }];"
