    {
      "parameters": {
        "jsCode": "const KEY = 'MySecretyKey2005';\nconst b = $input.first().json.body || {};\nif (b.key !== KEY) return [{ json: { ok: false, error: 'unauthorized' } }];\n\nconst rand = (n) => { const c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s = ''; for (let i = 0; i < n; i++) s += c[Math.floor(Math.random() * c.length)]; return s; };\nconst wf = $getWorkflowStaticData('global');\nconst sessionId = 'S' + new Date().toISOString().slice(0, 10).replace(/-/g, '') + '-' + rand(4);\nwf.session = {\n  active: true,\n  sessionId,\n  lecture: String(b.lecture || 'Lecture').trim(),\n  token: rand(6),\n  issuedAt: Date.now()\n};\nreturn [{ json: { ok: true, sessionId, lecture: wf.session.lecture } }];"
      },
