# Optional overrides for the lecture-hall map. No key is required for the
# defaults (OpenStreetMap tiles + OpenStreetMap Nominatim geocoding).
#
# VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
# VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# VITE_GEOCODE_URL="https://nominatim.openstreetmap.org/search"
# VITE_REVERSE_GEOCODE_URL="https://nominatim.openstreetmap.org/reverse"
